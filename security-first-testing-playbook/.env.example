# Copy to .env for local use. Every switch defaults to OFF, so the default test
# run needs no Docker, no network and no credentials.
#
# Slide 24: configuration lives in the environment and is validated at boot.
# See src/stplaybook/config.py — a malformed value fails loudly at start-up
# rather than halfway through a suite.

# --- Opt-in suites --------------------------------------------------------

# Run the Postgres integration test against a real engine (slide 20).
# Requires a container runtime and: pip install -e ".[postgres]"
STP_USE_POSTGRES=0

# Pinned image tag. ':latest' is refused as irreproducible.
STP_POSTGRES_IMAGE=postgres:17-alpine

# Enable coverage-guided fuzzing (slide 34).
# Requires: pip install -e ".[fuzz]"
STP_ENABLE_FUZZ=0
STP_FUZZ_SECONDS=30

# --- Quality gates (slide 25) ---------------------------------------------

# Diff coverage floor, percent of changed lines.
STP_DIFF_COVERAGE_FLOOR=80

# Mutation score floor for the critical band, percent.
STP_MUTATION_SCORE_FLOOR=70

# --- Never put a real secret in this file or in .env -----------------------
# Test credentials are ephemeral and scoped. A secret-scanning gate runs on
# every pull request precisely so that a real key committed here fails the
# build immediately rather than quietly.
